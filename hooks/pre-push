#!/bin/sh
# FinAssist ID pre-push quality gate (eval-platform, P5). Installed with: python -m evalplat.install_hook
# For every pushed branch, runs the eval subset on the pushed commit and on its baseline and blocks the push when the
# gate fails. Baseline: `main` for feature branches; the previous remote commit when main itself is pushed.
EVALPLAT_DIR="__EVALPLAT_DIR__"
ZERO=0000000000000000000000000000000000000000
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                  # branch deletion
  case "$remote_ref" in
    refs/heads/main) base="$remote_sha"; [ "$base" = "$ZERO" ] && continue ;;
    *) base="main" ;;
  esac
  # Name the head by its branch when the pushed commit is a branch tip (readable history), else by the commit.
  head="$local_sha"
  case "$local_ref" in refs/heads/*) [ "$(git rev-parse "$local_ref")" = "$local_sha" ] && head="${local_ref#refs/heads/}" ;; esac
  echo "[eval gate] $remote_ref: $head vs $base"
  ( cd "$EVALPLAT_DIR" && .venv/Scripts/python -m evalplat check --base "$base" --head "$head" ) || status=1
done
if [ $status -ne 0 ]; then
  echo "[eval gate] Push BLOCKED: quality regressed beyond gate.yaml. Report: $EVALPLAT_DIR/runs/latest_comment.md"
fi
exit $status
